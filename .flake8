[flake8]
max-line-length = 79
# Исключены каталог окружения и чисто сгенерированные Django файлы
# (settings.py, manage.py, миграции) — они не редактируются вручную.
exclude =
    .venv,
    .git,
    __pycache__,
    .pytest_cache,
    */migrations/*,
    manage.py,
    jointpurchases/settings.py
# main.py и utils.py — консольный ввод/вывод через print намеренный,
# поэтому правило flake8-print (T201) для них отключено.
per-file-ignores =
    main.py: T201
    utils.py: T201
